{
  "name": "dsh-doubao-paint",
  "version": "0.1.0",
  "description": "Doubao Web AI Image Generation Agent Tool plugin for DeepSeek Harness (豆包网页版 AI 生图 Agent 工具插件：向 Agent 注册 doubao_generate_image 与 doubao_image_status 原生工具，通过本机 Chrome + chrome-devtools-mcp CLI 操控 doubao.com 文生图、自动优选 wm0 无水印 2.7K 超清原图落盘并作为多模态图像附件返回)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "设计方案.md",
    "复刻清单.md"
  ],
  "scripts": {
    "test": "node --test test/index.test.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "doubao",
    "image-generation",
    "agent-tool",
    "chrome-devtools-mcp"
  ],
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.1.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "entry": "./lib/client.js",
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT"
}