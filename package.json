{
  "name": "dsh-doubao-paint",
  "version": "1.2.1",
  "description": "Doubao Web AI Image Generation Agent Tool plugin for DeepSeek Harness (豆包网页版 AI 生图 Agent 工具插件：向 Agent 注册 doubao_generate_image 与 doubao_image_status 原生工具，优先用本机 ego lite、回落 Chrome + chrome-devtools-mcp，操控 doubao.com 文生图、自动优选 wm0 无水印 2.7K 超清原图落盘并作为多模态图像附件返回)",
  "type": "module",
  "main": "lib/index.js",
  "author": "Jiazliang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jiazliang/dsh-doubao-paint.git"
  },
  "homepage": "https://github.com/Jiazliang/dsh-doubao-paint#readme",
  "bugs": {
    "url": "https://github.com/Jiazliang/dsh-doubao-paint/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "scripts/smoke.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/index.test.js",
    "smoke": "node scripts/smoke.mjs --offline",
    "verify": "npm test && npm run smoke"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "doubao",
    "image-generation",
    "agent-tool",
    "ego-browser",
    "chrome-devtools-mcp"
  ],
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-0",
    "@deepseek-ai/schemastery": ">=0.1.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "entry": "./lib/client.js",
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
